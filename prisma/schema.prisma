// Configura la generación de Prisma Client para TypeScript.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Indica que utilizaremos PostgreSQL.
datasource db {
  provider = "postgresql"
}

// Valores permitidos para identificar el tipo de movimiento.
enum TipoMovimiento {
  INGRESO
  GASTO
}

// Roles permitidos dentro del sistema.
enum RolUsuario {
  USUARIO
  ADMINISTRADOR
}

// MODELO DE LOS DATOS DE UNA CATEGORÍA EN LA DB
model Categoria {
  // Identificador principal y se incrementa automáticamente.
  id Int @id @default(autoincrement())

  // Nombre visible de la categoría.
  nombre String @db.VarChar(100)

  // Determina si se utiliza para ingresos o gastos.
  tipo TipoMovimiento

  // Permite desactivar una categoría sin eliminarla.
  activa Boolean @default(true)

  // Fecha de creación del registro.
  creadoEn DateTime @default(now()) @map("creado_en")

  // Se actualiza automáticamente cuando cambia el registro.
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // Impide repetir un mismo nombre para el mismo tipo.
  @@unique([nombre, tipo])
  // Nombre real de la tabla en PostgreSQL.
  @@map("categorias")
}

// MODELO DE LOS DATOS DE UN USUARIO EN LA DB
model Usuario {
  // Identificador principal generado automáticamente.
  id Int @id @default(autoincrement())

  // Nombre de la persona.
  nombre String @db.VarChar(100)

  // Correo utilizado para registrarse e iniciar sesión.
  correo String @unique @db.VarChar(150)

  // Contendrá la contraseña cifrada, nunca la contraseña original.
  contrasenaHash String @map("contrasena_hash") @db.VarChar(255)

  // Define los permisos del usuario.
  rol RolUsuario @default(USUARIO)

  // Permite bloquear una cuenta sin eliminarla.
  activo Boolean @default(true)

  // Fecha en que se registró el usuario.
  creadoEn DateTime @default(now()) @map("creado_en")

  // Fecha de la última modificación.
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // Nombre real de la tabla en PostgreSQL.
  @@map("usuarios")
}

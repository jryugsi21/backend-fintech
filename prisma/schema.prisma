// Configura la generación de Prisma Client para TypeScript.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Indica que utilizaremos PostgreSQL.
datasource db {
  provider = "postgresql"
}

// Valores permitidos para identificar el tipo de movimiento.
enum TipoMovimiento {
  INGRESO
  GASTO
}

// Roles permitidos dentro del sistema.
enum RolUsuario {
  USUARIO
  ADMINISTRADOR
}

// ---------- MODELO DE LOS DATOS DE UNA CATEGORÍA EN LA DB ----------
model Categoria {
  // Identificador principal y se incrementa automáticamente.
  id Int @id @default(autoincrement())

  // Nombre visible de la categoría.
  nombre String @db.VarChar(100)

  // Determina si se utiliza para ingresos o gastos.
  tipo TipoMovimiento

  // Permite desactivar una categoría sin eliminarla.
  activa Boolean @default(true)

  // Fecha de creación del registro.
  creadoEn DateTime @default(now()) @map("creado_en")

  // Se actualiza automáticamente cuando cambia el registro.
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // ----- Relaciones ------
  // Relación movimientos de una categoría.
  movimientos Movimiento[]

  // Presupuestos asociados con esta categoría.
  presupuestos Presupuesto[]

  // Impide repetir un mismo nombre para el mismo tipo.
  @@unique([nombre, tipo])
  // Nombre real de la tabla en PostgreSQL.
  @@map("categorias")
}

// ---------- MODELO DE LOS DATOS DE UN USUARIO ----------
model Usuario {
  // Identificador principal.
  id Int @id @default(autoincrement())

  // Nombre de la persona.
  nombre String @db.VarChar(100)

  // Correo utilizado para registrarse e iniciar sesión.
  correo String @unique @db.VarChar(150)

  // Contendrá la contraseña cifrada, nunca la contraseña original.
  contrasenaHash String @map("contrasena_hash") @db.VarChar(255)

  // Define los permisos del usuario.
  rol RolUsuario @default(USUARIO)

  // Permite bloquear una cuenta sin eliminarla.
  activo Boolean @default(true)

  // Fecha en que se registró el usuario.
  creadoEn DateTime @default(now()) @map("creado_en")

  // Fecha de la última modificación.
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // -----RELACIONES-----
  // Movimientos creados por el usuario.
  movimientos Movimiento[]

  // Presupuestos creados por el usuario.
  presupuestos Presupuesto[]

  // Metas creadas por el usuario.
  metasAhorro MetaAhorro[]

  // Nombre real de la tabla en PostgreSQL.
  @@map("usuarios")
}

// ---------- MODELO DE DATOS DE UN MOVIMIENTO -----------
model Movimiento {
  // Identificador principal.
  id Int @id @default(autoincrement())

  // Indica si el movimiento es un INGRESO o un GASTO.
  tipo TipoMovimiento

  // Valor económico del movimiento, permite hasta 12 dígitos y 2 decimales.
  monto Decimal @db.Decimal(12, 2)

  // Información adicional sobre el movimiento ("?" significa opcional)
  descripcion String? @db.VarChar(255)

  // Fecha en que se realizó movimiento, si no se envía una fecha se utiliza la actual.
  fecha DateTime @default(now())

  // Fecha en la que se realizó la eliminación lógica.
  eliminadoEn DateTime? @map("eliminado_en")

  // ----- Claves foráneas -----
  usuarioId Int @map("usuario_id") //Id del usuario al que pertenece el movimiento.

  // Identificador de la categoría asociada al movimiento.
  categoriaId Int @map("categoria_id") //Id de la categoría asociada al movimiento.

  // Fecha en la que se creó este registro en la base de datos.
  creadoEn DateTime @default(now()) @map("creado_en")

  // Fecha de la última modificación realizada al registro.
  // Prisma la actualiza automáticamente.
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // ----- Relaciones de movimientos con usuarios y categorías ------
  // Relación con usuarios.
  // Indica que usuarioId debe corresponder al id de un usuario existente.
  // Restrict evita eliminar un usuario si todavía tiene movimientos relacionados.
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  // Relación con categoría.
  // Indica que categoriaId debe corresponder al id de una categoría existente.
  // Restrict evita eliminar una categoría si tiene movimientos relacionados.
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  // Crea índice utilizando usuarioId y fecha, ayuda a realizar más rápido consultas como:
  // "Obtener los movimientos de un usuario ordenados o filtrados por fecha".
  @@index([usuarioId, fecha])
  // Crea índice para categoriaId y ayuda a buscar más rápido los movimientos pertenecientes a una categoría.
  @@index([categoriaId])
  // Nombre real de la tabla en PostgreSQL.
  @@map("movimientos")
}

// ---------- MODELO DE LOS PRESUPUESTOS MENSUALES -----------
model Presupuesto {
  // Identificador principal generado automáticamente.
  id Int @id @default(autoincrement())

  // Cantidad máxima que el usuario desea gastar.
  montoLimite Decimal @map("monto_limite") @db.Decimal(12, 2)

  // Mes correspondiente al presupuesto, desde 1 hasta 12.
  mes Int

  // Año correspondiente al presupuesto.
  anio Int

  // Porcentaje de consumo en el que se deberá generar una alerta.
  porcentajeAlerta Int @default(80) @map("porcentaje_alerta")

  // Indica si el presupuesto continúa habilitado.
  activo Boolean @default(true)

  // Fechas de control interno del registro.
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // ------ Claves foráneas ------
  usuarioId   Int @map("usuario_id")
  categoriaId Int @map("categoria_id")

  // ----- Relaciones ------
  // Un presupuesto pertenece a un usuario y a una categoría.
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  // Impide presupuestos repetidos para la misma categoría y periodo.
  @@unique([usuarioId, categoriaId, anio, mes])
  // Mejoran las búsquedas por usuario, periodo y categoría.
  @@index([usuarioId, anio, mes, activo])
  @@index([categoriaId])
  @@map("presupuestos")
}

// ---------- MODELO DE UNA META DE AHORRO ----------
model MetaAhorro {
  // Identificador principal de la meta.
  id Int @id @default(autoincrement())

  // Nombre que el usuario le da a su meta.
  nombre String @db.VarChar(100)

  // Cantidad de dinero que el usuario quiere alcanzar.
  montoObjetivo Decimal @map("monto_objetivo") @db.Decimal(12, 2)

  // Fecha límite o fecha esperada para cumplir la meta.
  fechaObjetivo DateTime @map("fecha_objetivo") @db.Date

  // Indica si la meta sigue activa.
  activo Boolean @default(true)

  // Fecha en la que se creó la meta.
  creadoEn DateTime @default(now()) @map("creado_en")

  // Fecha de la última modificación de la meta.
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // ----- Clave foránea -----
  usuarioId Int @map("usuario_id")

  // ----- Relaciones -----
  // Relación con usuarios.
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Relación con aportes.
  aportes AporteMeta[]

  // Crea un índice para facilitar búsquedas de metas
  @@index([usuarioId, activo, fechaObjetivo])
  // Nombre real de la tabla en PostgreSQL.
  @@map("metas_ahorro")
}

// ---------- MODELO DE UN APORTE A UNA META ----------
model AporteMeta {
  // Identificador principal del aporte.
  id Int @id @default(autoincrement())

  // Cantidad de dinero aportada a la meta.
  monto Decimal @db.Decimal(12, 2)

  // Fecha en la que se registró el aporte.
  creadoEn DateTime @default(now()) @map("creado_en")

  // Fecha en la que el aporte fue eliminado de forma lógica.
  eliminadoEn DateTime? @map("eliminado_en")

  // ----- Clave foránea -----
  // Id de la meta de ahorro a la que pertenece este aporte.
  metaAhorroId Int @map("meta_ahorro_id")

  // ----- Relaciones -----
  // Relación coon MetaAhorro.
  metaAhorro MetaAhorro @relation(fields: [metaAhorroId], references: [id], onDelete: Cascade)

  // Crea un índice para hacer más rápidas las consultas
  @@index([metaAhorroId, eliminadoEn, creadoEn])
  // Nombre real de la tabla en PostgreSQL.
  @@map("aportes_meta")
}
